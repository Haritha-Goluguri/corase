# ==========================================
# CORASE Streetwear - Environment Configuration
# ==========================================

# 1. MongoDB Database
# Connect to your MongoDB Atlas cluster or local instance
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/corase?retryWrites=true&w=majority

# 2. NextAuth Authentication
# For production on corase.in:
NEXTAUTH_URL=https://corase.in
# For local development:
# NEXTAUTH_URL=http://localhost:3000

# Secret key (generate via: openssl rand -base64 32 or any strong 32+ char string)
NEXTAUTH_SECRET=your_nextauth_secret_key_here

# 3. Google OAuth 2.0 (Required for "Sign in with Google")
# Setup Guide:
# 1. Go to Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Application Type: Web Application)
# 3. Add Authorized JavaScript origins:
#    - https://corase.in
#    - https://www.corase.in
#    - http://localhost:3000
# 4. Add Authorized redirect URIs:
#    - https://corase.in/api/auth/callback/google
#    - https://www.corase.in/api/auth/callback/google
#    - http://localhost:3000/api/auth/callback/google
# 5. Copy Client ID and Client Secret below:
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# 4. Store Owner / Admin Access
# Add your Google email address here to automatically grant Administrator privileges upon login
ADMIN_EMAIL=your_email@gmail.com

# 5. Razorpay Payments
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# 5. Direct UPI Payment
NEXT_PUBLIC_UPI_ID=yourname@okaxis

# 6. Cloudinary (Optional, for admin product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
